{
  "name": "ultimate-tv-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Software-defined TV host and Android TV remote bridge",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "tv": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "commander": "^14.0.1",
    "protobufjs": "^7.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "dev.ultimatetv.os",
    "productName": "Ultimate TV OS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Ultimate-TV-OS-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Ultimate-TV-OS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "Ultimate-TV-OS-${version}-${arch}.${ext}"
    }
  }
}
