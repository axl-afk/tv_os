{
  "name": "ultimate-tv-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Software-defined TV host and Android TV remote bridge",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "tv": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "commander": "^14.0.1",
    "protobufjs": "^7.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
