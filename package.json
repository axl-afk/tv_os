{
  "name": "ultimate-tv-os",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "Software-defined TV host and Android TV remote bridge",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "tv": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "runtime:probe": "tsx src/runtime/probe.ts",
    "runtime:smoke": "tsx src/runtime/smoke.ts",
    "desktop:check": "node --check desktop/renderer.js && node --check desktop/tv.js && node --check desktop/preload.cjs && node --check desktop/tv-preload.cjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "commander": "^14.0.1",
    "protobufjs": "^7.5.4",
    "selfsigned": "^5.5.0",
    "fast-xml-parser": "^5.3.0",
    "yauzl": "^3.2.0",
    "@grpc/grpc-js": "^1.14.2",
    "@grpc/proto-loader": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "@types/yauzl": "^2.10.3"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "dev.ultimatetv.os",
    "productName": "Ultimate TV OS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "proto/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Ultimate-TV-OS-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Ultimate-TV-OS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "Ultimate-TV-OS-${version}-${arch}.${ext}",
      "syncDesktopName": true
    }
  },
  "author": {
    "name": "Ultimate TV OS",
    "email": "opensource@ultimatetv.dev"
  },
  "desktopName": "ultimate-tv-os"
}
